long readHX710B() {
  while (digitalRead(HX710B_DOUT) == HIGH) {
    yield();
  }

  long rawValue = 0;
  for (int i = 0; i < 24; i++) {
    digitalWrite(HX710B_SCK, HIGH);
    delayMicroseconds(1);
    rawValue = (rawValue << 1) | digitalRead(HX710B_DOUT);
    digitalWrite(HX710B_SCK, LOW);
    delayMicroseconds(1);
  }

  // 25th pulse to set channel/mode for next reading
  digitalWrite(HX710B_SCK, HIGH);
  delayMicroseconds(1);
  digitalWrite(HX710B_SCK, LOW);
  delayMicroseconds(1);

  // Convert 24-bit two's complement to signed 32-bit long
  if (rawValue & 0x800000) {
    rawValue |= ~0xFFFFFFL;
  }

  return rawValue;
}

void setRelayState(bool energize) {
  if (RELAY_ACTIVE_LOW) {
    digitalWrite(RELAY_PIN, energize ? LOW : HIGH);
  } else {
    digitalWrite(RELAY_PIN, energize ? HIGH : LOW);
  }
}

